{
  "model": {
    "name": "claude-3-5-sonnet-20241022",
    "max_tokens": 100000,
    "temperature": 0.1,
    "timeout": 300
  },
  "chunking": {
    "default_chunk_size": 15000,
    "default_overlap": 500,
    "min_chunk_size": 1000,
    "max_chunk_size": 100000,
    "max_overlap_ratio": 0.3
  },
  "rate_limit": {
    "requests_per_minute": 50,
    "tokens_per_minute": 100000,
    "max_retries": 3,
    "base_delay": 1.0,
    "max_delay": 60.0
  },
  "web": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false,
    "max_file_size": 52428800,
    "upload_dir": "uploads",
    "output_dir": "outputs",
    "session_timeout": 3600
  },
  "logging": {
    "level": "INFO",
    "log_dir": "logs",
    "max_file_size": 10485760,
    "backup_count": 5,
    "session_log_retention_days": 7
  },
  "security": {
    "allowed_origins": ["*"],
    "max_concurrent_sessions": 100,
    "api_key_validation": true,
    "file_type_validation": true
  }
}